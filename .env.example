# ─────────────────────────────────────────────────────────────────────────────
# Rumi environment variables
# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables. NEXT_PUBLIC_* values are inlined
# into the browser bundle at build time — never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Public URL of the app, no trailing slash. Used for email links, OAuth
# redirects and the PWA manifest.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Dashboard → Project Settings → API). For the local stack,
# `npm run db:start` prints these values ("API URL", "anon key", "service_role key").
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — used for match recompute,
# notifications, moderation, rate limiting and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# 64 hex characters (32 bytes). Encrypts third-party OAuth tokens at rest
# (AES-256-GCM). Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Campus ──────────────────────────────────────────────────────────────────
# Copy on public pages. Which email domains may sign up, and the neighborhoods
# students pick from, live in the `schools` and `areas` tables — adding a
# campus is a data change (see README → "Adding a school").

NEXT_PUBLIC_LAUNCH_SCHOOL_ID=asu
NEXT_PUBLIC_LAUNCH_SCHOOL_NAME=Arizona State University
NEXT_PUBLIC_LAUNCH_SCHOOL_SHORT=ASU
NEXT_PUBLIC_LAUNCH_SCHOOL_DOMAIN=asu.edu
NEXT_PUBLIC_LAUNCH_SCHOOL_CITY=Tempe
# Shown next to 911 in safety copy.
NEXT_PUBLIC_LAUNCH_SCHOOL_POLICE_NAME=ASU Police
NEXT_PUBLIC_LAUNCH_SCHOOL_POLICE_PHONE=480-965-3456
# Server-rendered timestamps use the campus time zone; browsers switch to local time.
NEXT_PUBLIC_CAMPUS_TZ=America/Phoenix

# ── Email ───────────────────────────────────────────────────────────────────
# Notification emails (intros, messages, daily strong-match digest).
# Delivery order: Resend if RESEND_API_KEY is set, else SMTP_URL, else a
# console log. Sign-in codes are sent by Supabase Auth itself — configure SMTP
# for your Supabase project too (Dashboard → Authentication → SMTP).

RESEND_API_KEY=
# Local: Mailpit, started by `supabase start` (inbox UI at http://127.0.0.1:54324).
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM=Rumi <hello@rumi.app>
NEXT_PUBLIC_SUPPORT_EMAIL=support@rumi.app

# ── Admin & operations ──────────────────────────────────────────────────────

# Comma-separated. These accounts get the safety admin dashboard (/admin)
# the next time they sign in.
ADMIN_EMAILS=
# Protects /api/cron/* — Vercel Cron sends it as a Bearer token. Required in
# production; without it the jobs only run in local development.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional Slack/Discord-compatible webhook that hears about new reports and
# automatic scam/abuse flags.
MODERATION_WEBHOOK_URL=

# ── Optional: Google sign-in ────────────────────────────────────────────────
# Students still need a school Google account (the sign-up trigger rejects
# other domains). Configure the Google provider in Supabase first.

NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# For the local stack only — read by `supabase start` via supabase/config.toml.
# Put these in supabase/.env (and set [auth.external.google] enabled = true).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── Optional: Spotify ───────────────────────────────────────────────────────
# Shows top artists on profiles and nudges scores for shared taste.
# Create an app at https://developer.spotify.com/dashboard and add the
# redirect URI below to it.

NEXT_PUBLIC_SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Defaults to $NEXT_PUBLIC_APP_URL/api/spotify/callback.
SPOTIFY_REDIRECT_URI=

# ── Seeding (npm run seed) ──────────────────────────────────────────────────

# "unsplash" downloads a small set of real portraits for demo profiles
# (needs network access; falls back to generated monograms).
SEED_PHOTOS=
# "true" allows seeding a non-local project (staging only — never production).
SEED_ALLOW_REMOTE=

# ── End-to-end tests (npm run test:e2e) ─────────────────────────────────────

# Test against an already running server instead of starting `npm run dev`.
PLAYWRIGHT_BASE_URL=
# Use an existing Chromium binary instead of `npx playwright install chromium`.
PLAYWRIGHT_CHROMIUM_PATH=
# Mailpit API, used to read sign-in codes.
MAILPIT_URL=http://127.0.0.1:54324
