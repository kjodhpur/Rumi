# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_SEED_PROFILES=true

# Optional: set to 1 only after placing licensed Degular/Basier files (not used — Inter + DM Sans via Google)
# NEXT_PUBLIC_USE_BRAND_FONTS=0

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Spotify (Developer Dashboard → App settings)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Encrypt Spotify refresh tokens (32-byte hex = 64 hex chars)
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Comma-separated ASU emails allowed to access /admin
ADMIN_EMAILS=you@asu.edu

# Protect Vercel cron routes (Vercel sets CRON_SECRET automatically if configured;
# also set it manually for local testing)
CRON_SECRET=generate-a-long-random-string
